# metawiki 配置模板 —— 复制成 .env 并填好真实值; .env 不要提交到版本库。
# settings.py 启动时自动加载项目根的 .env(真实环境变量优先, 不覆盖)。

# ---- Postgres: 指标元数据库 metadata_kb (P1 写入目标) ----
# 方式一: 整串 DSN(优先级最高)
# BIRAG_PG_DSN=host=localhost port=5432 dbname=metadata_kb user=postgres password=改我

# 方式二: 分量(BIRAG_PG_DSN 未设时才用)
BIRAG_PG_HOST=localhost
BIRAG_PG_PORT=5432
BIRAG_PG_DB=metadata_kb
BIRAG_PG_USER=postgres
BIRAG_PG_PASSWORD=
BIRAG_PG_METRICS_TABLE=metrics
BIRAG_PG_DATASETS_TABLE=datasets

# ---- MySQL: BI 元数据库 (P2 · ba.data_set 数据集 SQL 来源) ----
BIRAG_MYSQL_HOST=10.20.103.20
BIRAG_MYSQL_PORT=3307
BIRAG_MYSQL_DB=open_api
BIRAG_MYSQL_USER=root
BIRAG_MYSQL_PASSWORD=改我
BIRAG_MYSQL_DATASET_SCHEMA=ba

# ---- 可选: 覆盖知识库目录 / 前端扫描产物路径 ----
# BIRAG_KB_ROOT=/abs/path/to/knowledge_base
# BIRAG_CHART_INDEX=/abs/path/to/chart-index.generated.json
