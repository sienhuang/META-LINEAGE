WITH
basic AS (
    SELECT
        channel,
        country,
        network,
        os,
        zone_group
    FROM t1
    WHERE t1.rn = 1
),
t_active_di AS (
    SELECT
        COUNT(DISTINCT logymd) AS active_days,
        roleid
    FROM bi_test.dwm_zgame_active_role_zone_di AS dwm_zgame_active_role_zone_di
    WHERE logymd BETWEEN DATE_FORMAT('2026-05-31', 'yyyy-MM-01') AND LAST_DAY('2026-05-31') AND logymd >= '2023-07-01'
    GROUP BY roleid
),
subquery_9 AS (
    SELECT
        COALESCE(SUM(act.active_days) / (CASE WHEN SUBSTRING('2026-05-31', 1, 7) = '2023-07' THEN (DATEDIFF(LAST_DAY('2026-05-31'), '2023-07-01') + 1) ELSE (DATEDIFF(LAST_DAY('2026-05-31'), DATE_FORMAT('2026-05-31', 'yyyy-MM-01')) + 1) END), 0) AS avg_active_cnt /* 日均活跃天数 */,
        basic.channel,
        basic.country,
        COUNT(DISTINCT act.roleid) AS mau,
        basic.network,
        basic.os,
        basic.zone_group
    FROM basic
    LEFT JOIN t_active_di
        ON basic.accountid = act.roleid
    GROUP BY basic.country, basic.os, basic.channel, basic.network, basic.zone_group
),
final_insert_branch_1 AS (
    SELECT
        COALESCE(channel, 'unknown') AS channel,
        COALESCE(country, 'unknown') AS country,
        CAST(MAP('avg_active_cnt', COALESCE(avg_active_cnt, 0), 'mau', COALESCE(mau, 0)) AS MAP<STRING, DECIMAL(38, 18)>) AS indicator_map,
        COALESCE(network, 'unknown') AS network,
        COALESCE(os, 'unknown') AS os,
        COALESCE(zone_group, 'unknown') AS zone_group
    FROM subquery_9
),
subquery_11 AS (
    SELECT
        COALESCE(SUM(act.active_days) / (CASE WHEN SUBSTRING('2026-05-31', 1, 7) = '2023-07' THEN (DATEDIFF(LAST_DAY('2026-05-31'), '2023-07-01') + 1) ELSE (DATEDIFF(LAST_DAY('2026-05-31'), DATE_FORMAT('2026-05-31', 'yyyy-MM-01')) + 1) END), 0) AS avg_active_cnt /* 日均活跃天数 */,
        basic.channel,
        basic.country,
        COUNT(DISTINCT act.roleid) AS mau,
        basic.network,
        basic.os,
        basic.zone_group
    FROM basic
    LEFT JOIN t_active_di
        ON basic.accountid = act.roleid
    WHERE basic.is_cur_bot = 0
    GROUP BY basic.country, basic.os, basic.channel, basic.network, basic.zone_group
),
final_insert_branch_2 AS (
    SELECT
        COALESCE(channel, 'unknown') AS channel,
        COALESCE(country, 'unknown') AS country,
        CAST(MAP('avg_active_cnt', COALESCE(avg_active_cnt, 0), 'mau', COALESCE(mau, 0)) AS MAP<STRING, DECIMAL(38, 18)>) AS indicator_map,
        COALESCE(network, 'unknown') AS network,
        COALESCE(os, 'unknown') AS os,
        COALESCE(zone_group, 'unknown') AS zone_group
    FROM subquery_11
),
ads_gamebi_roger_secondary_di AS (
    SELECT
        UNION_BRANCH_COLUMN[6],
        UNION_BRANCH_COLUMN[2],
        UNION_BRANCH_COLUMN[4],
        UNION_BRANCH_COLUMN[3],
        UNION_BRANCH_COLUMN[5],
        UNION_BRANCH_COLUMN[13]
    FROM final_insert_branch_1
)
SELECT
    ads_gamebi_roger_secondary_di.indicator_map
FROM ads_gamebi_roger_secondary_di;
