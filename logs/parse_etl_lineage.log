    temp_active_retain_30activedays.is_active,
    temp_active_retain_30activedays.logymd,
    temp_active_retain_30activedays.new_type,
    temp_active_retain_30activedays.user_period,
    temp_active_retain_30activedays.usercnt
FROM temp_active_retain_30activedays;
