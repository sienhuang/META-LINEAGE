WITH
a_branch_1 AS (
    SELECT
        logymd,
        roleid,
        usercreateymd,
        zoneid
    FROM zgame_damai_ods.gameserver_login AS gameserver_login
    WHERE logymd = '2026-05-31' AND zoneid >= 50001
),
a_branch_2 AS (
    SELECT
        logymd,
        usercreateymd
    FROM zgame_damai_ods.gameserver_charge AS gameserver_charge
    WHERE logymd = '2026-05-31' AND zoneid >= 50001
),
a AS (
    SELECT
        UNION_BRANCH_COLUMN[3],
        UNION_BRANCH_COLUMN[4]
    FROM a_branch_1
),
role_info AS (
    SELECT
        CASE WHEN DATEDIFF(logymd, usercreateymd) + 1 = 1 THEN '0_当天新增' WHEN DATEDIFF(logymd, usercreateymd) + 1 BETWEEN 2 AND 3 THEN '1_2-3天用户' WHEN DATEDIFF(logymd, usercreateymd) + 1 BETWEEN 4 AND 7 THEN '2_4-7天用户' WHEN DATEDIFF(logymd, usercreateymd) + 1 BETWEEN 8 AND 14 THEN '3_8-14天用户' WHEN DATEDIFF(logymd, usercreateymd) + 1 BETWEEN 15 AND 21 THEN '4_15-21天用户' WHEN DATEDIFF(logymd, usercreateymd) + 1 BETWEEN 22 AND 28 THEN '5_22-28天用户' WHEN DATEDIFF(logymd, usercreateymd) + 1 > 28 THEN '6_28天以上' END AS regday_label
    FROM a
    WHERE b.roleid IS NULL
),
active_info AS (
    SELECT
        roleid,
        zoneid
    FROM zgame_damai_ods.gameserver_login AS gameserver_login
    WHERE logymd = '2026-05-31' AND zoneid >= 50001
),
ads_zgame_active_lottery_di AS (
    SELECT
        COUNT(DISTINCT a.roleid, a.zoneid) AS active_role_num,
        regday_label
    FROM role_info
    LEFT JOIN active_info
        ON r.roleid = a.roleid AND r.zoneid = a.zoneid
    GROUP BY regday_label
)
SELECT
    ads_zgame_active_lottery_di.active_role_num
FROM ads_zgame_active_lottery_di;
