WITH
t_create AS (
    SELECT
        CASE WHEN LOWER(createrole_channel) = 'and_gb' THEN 'and_gb' WHEN LOWER(createrole_channel) = 'ios_gb' THEN 'ios_gb' ELSE 'unknown' END AS channel,
        IF(createrole_country IS NULL OR TRIM(createrole_country) IN ('-', ''), 'unknown', LOWER(createrole_country)) AS country
    FROM w5_ods.create_role AS create_role
    WHERE logymd <= '2026-05-31' AND logymd >= '2026-04-22' AND zoneid > 10000
),
t AS (
    SELECT
        CASE WHEN LOWER(createrole_channel) = 'and_gb' THEN 'and_gb' WHEN LOWER(createrole_channel) = 'ios_gb' THEN 'ios_gb' ELSE 'unknown' END AS channel,
        IF(createrole_country IS NULL OR TRIM(createrole_country) IN ('-', ''), 'unknown', LOWER(createrole_country)) AS country
    FROM w5_ods.login AS login
    WHERE logymd = '2026-05-31' AND logymd >= '2026-04-22' AND zoneid > 10000
),
t_login AS (
    SELECT
        channel,
        country
    FROM t
    WHERE rn = 1
),
t_logout AS (
    SELECT
        t_login.channel,
        t_login.country
    FROM t_login
),
subquery_11 AS (
    SELECT
        CASE WHEN LOWER(createrole_channel) = 'and_gb' THEN 'and_gb' WHEN LOWER(createrole_channel) = 'ios_gb' THEN 'ios_gb' ELSE 'unknown' END AS channel,
        IF(createrole_country IS NULL OR TRIM(createrole_country) IN ('-', ''), 'unknown', LOWER(createrole_country)) AS country,
        roleid,
        TIME AS server_time
    FROM w5_ods.charge AS charge
    WHERE logymd = '2026-05-31' AND logymd >= '2026-04-22' AND zoneid > 10000
),
subquery_10 AS (
    SELECT
        FIRST_VALUE(channel) OVER (PARTITION BY roleid ORDER BY server_time ASC) AS channel,
        FIRST_VALUE(country) OVER (PARTITION BY roleid ORDER BY server_time ASC) AS country,
        roleid
    FROM subquery_11
),
t_charge AS (
    SELECT
        channel,
        country,
        roleid
    FROM subquery_10
    GROUP BY roleid, country, channel
),
t AS (
    SELECT
        channel,
        country
    FROM t_create
),
t_branch_1 AS (
    SELECT
        channel,
        country,
        'create' AS tag
    FROM t
    WHERE rn = 1
),
t_branch_2 AS (
    SELECT
        channel,
        country,
        'login' AS tag
    FROM t_login
),
t_branch_3 AS (
    SELECT
        channel,
        country,
        'logout' AS tag
    FROM t_logout
),
t_branch_4 AS (
    SELECT
        channel,
        country,
        roleid,
        'charge' AS tag
    FROM t_charge
),
t AS (
    SELECT
        UNION_BRANCH_COLUMN[3],
        UNION_BRANCH_COLUMN[4],
        UNION_BRANCH_COLUMN[2]
    FROM t_branch_1
),
indicator_role AS (
    SELECT
        channel,
        COALESCE(country, 'unknown') AS country,
        tag
    FROM t
),
t3 AS (
    SELECT
        SUM(CASE WHEN tag = 'login' THEN 1 ELSE 0 END) AS active_cnt /* DAU */,
        COALESCE(channel, 'unknown') AS channel,
        COALESCE(country, 'unknown') AS country,
        SUM(CASE WHEN tag = 'create' THEN 1 ELSE 0 END) AS register_cnt_total /* 累计注册用户数 */
    FROM indicator_role
    GROUP BY COALESCE(country, 'unknown'), COALESCE(channel, 'unknown')
),
ads_gamebi_roger_primary_di AS (
    SELECT
        COALESCE(t3.active_cnt, 0) AS active_cnt,
        COALESCE(t3.active_cnt, 0) AS active_cnt_period,
        COALESCE(t3.channel, 'unknown') AS channel,
        COALESCE(t3.register_cnt_total, 0) AS register_cnt_total
    FROM t_dim
    LEFT JOIN t3
        ON t0.country = t3.country
)
SELECT
    ads_gamebi_roger_primary_di.active_cnt
FROM ads_gamebi_roger_primary_di;
