2026-06-08 18:11:25,693 metawiki.parse_etl.lineage INFO 递归血缘 3 跳:
2026-06-08 18:11:25,693 metawiki.parse_etl.lineage INFO   [d1] ml_temp.temp_active_retain_30activedays.amount <= a.charge_amt_total [aggregated]
2026-06-08 18:11:25,693 metawiki.parse_etl.lineage INFO   [d2] a.charge_amt_total <= a.charge_amt_total [direct]
2026-06-08 18:11:25,693 metawiki.parse_etl.lineage INFO   [d3] a.charge_amt_total <= mt_dm.dm_active_pay_role_zone_di.charge_amt_total [direct]
2026-06-08 18:11:25,693 metawiki.parse_etl.lineage INFO 整条链路 SQL:
WITH
a AS (
    SELECT
        active_date_diff,
        charge_amt_total,
        is_active,
        logymd,
        roleid,
        CASE WHEN register_date_diff < 0 THEN '无信息' WHEN register_date_diff = 0 THEN '0' WHEN register_date_diff <= 6 THEN '[1,6]' WHEN register_date_diff <= 29 THEN '[7,29]' WHEN register_date_diff <= 89 THEN '[30,89]' WHEN register_date_diff <= 179 THEN '[90,179]' WHEN register_date_diff <= 359 THEN '[180,359]' WHEN register_date_diff <= 719 THEN '[360,719]' WHEN register_date_diff >= 720 THEN '[720,)' ELSE '无信息' END AS user_period,
        zoneid
    FROM mt_dm.dm_active_pay_role_zone_di AS dm_active_pay_role_zone_di
    WHERE active_date = '2026-05-30' AND logymd IN ('2026-05-30', '2026-05-29', '2026-05-28', '2026-05-24', '2026-05-17', '2026-05-01', '2026-03-02') AND active_date_diff IN (0, 1, 2, 6, 13, 29, 89)
),
b AS (
    SELECT
        MAX(LEVEL) AS day_max_level,
        logymd,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE zoneid < 57000 AND is_ai = 0 AND logymd IN ('2026-05-30', '2026-05-29', '2026-05-28', '2026-05-24', '2026-05-17', '2026-05-01', '2026-03-02') AND appid = 'mlbb'
    GROUP BY roleid, zoneid, logymd
),
c AS (
    SELECT
        create_os,
        LOWER(first_mt_country) AS first_mt_country,
        first_network_name,
        CASE WHEN new_type = 1 THEN '小号回流新增' WHEN new_type = 2 THEN '模拟器新增' WHEN new_type = 3 THEN '纯净新增' WHEN new_type = 4 THEN '切换设备换绑' WHEN new_type = 5 THEN '小号新增' ELSE '无信息' END AS new_type,
        roleid,
        zoneid
    FROM mt_dim.dim_basic_role_zone_df AS dim_basic_role_zone_df
    WHERE logymd = IF('2026-05-30' < '2023-01-01', '2023-01-01', '2026-05-30') AND appid = 'mlbb' AND zoneid < 57000 AND is_ai = 0
