    GROUP BY a.logymd, a.roleid, a.zoneid, b.day_max_level, d.country, c.new_type, a.is_active, a.charge_amt_total, a.user_period, a.active_date_diff, c.create_os, c.first_network_name, (COALESCE(e.his_activedays_before_1, 0) - COALESCE(f.his_activedays_before_31, 0))
),
temp_active_retain_30activedays AS (
    SELECT
        active_date_diff,
        CASE WHEN active_days = 0 THEN '0' WHEN active_days BETWEEN 1 AND 2 THEN '[1,2]' WHEN active_days BETWEEN 3 AND 8 THEN '[3,8]' WHEN active_days BETWEEN 9 AND 17 THEN '[9,17]' WHEN active_days BETWEEN 18 AND 25 THEN '[18,25]' WHEN active_days BETWEEN 26 AND 30 THEN '[26,30]' ELSE '无信息' END AS active_days /* 前30天活跃天数分层 */,
        SUM(charge_amt_total) AS amount /* [logymd,logymd + active_date_diff]，区间内总付费（美分） */,
        CASE WHEN country IS NULL THEN '无信息' ELSE country END AS country,
        create_os,
        CASE WHEN day_max_level BETWEEN 1 AND 10 THEN '[1,10]' WHEN day_max_level BETWEEN 11 AND 20 THEN '[11,20]' WHEN day_max_level BETWEEN 21 AND 30 THEN '[21,30]' WHEN day_max_level BETWEEN 31 AND 40 THEN '[31,40]' WHEN day_max_level BETWEEN 41 AND 50 THEN '[41,50]' WHEN day_max_level BETWEEN 51 AND 60 THEN '[51,60]' WHEN day_max_level BETWEEN 61 AND 70 THEN '[61,70]' WHEN day_max_level BETWEEN 71 AND 80 THEN '[71,80]' WHEN day_max_level BETWEEN 81 AND 90 THEN '[81,90]' WHEN day_max_level BETWEEN 91 AND 100 THEN '[91,100]' WHEN day_max_level >= 101 THEN '[101,)' ELSE '无信息' END AS day_max_level,
        first_network_name,
        is_active,
        logymd /* 活跃日期 */,
        new_type,
        user_period,
        COUNT(DISTINCT roleid, zoneid) AS usercnt /* 角色数 */
    FROM a
    GROUP BY logymd /* 活跃日期 */, active_date_diff, is_active, CASE WHEN day_max_level BETWEEN 1 AND 10 THEN '[1,10]' WHEN day_max_level BETWEEN 11 AND 20 THEN '[11,20]' WHEN day_max_level BETWEEN 21 AND 30 THEN '[21,30]' WHEN day_max_level BETWEEN 31 AND 40 THEN '[31,40]' WHEN day_max_level BETWEEN 41 AND 50 THEN '[41,50]' WHEN day_max_level BETWEEN 51 AND 60 THEN '[51,60]' WHEN day_max_level BETWEEN 61 AND 70 THEN '[61,70]' WHEN day_max_level BETWEEN 71 AND 80 THEN '[71,80]' WHEN day_max_level BETWEEN 81 AND 90 THEN '[81,90]' WHEN day_max_level BETWEEN 91 AND 100 THEN '[91,100]' WHEN day_max_level >= 101 THEN '[101,)' ELSE '无信息' END, CASE WHEN country IS NULL THEN '无信息' ELSE country END, new_type, user_period, create_os, first_network_name, CASE WHEN active_days = 0 THEN '0' WHEN active_days BETWEEN 1 AND 2 THEN '[1,2]' WHEN active_days BETWEEN 3 AND 8 THEN '[3,8]' WHEN active_days BETWEEN 9 AND 17 THEN '[9,17]' WHEN active_days BETWEEN 18 AND 25 THEN '[18,25]' WHEN active_days BETWEEN 26 AND 30 THEN '[26,30]' ELSE '无信息' END
)
SELECT
    temp_active_retain_30activedays.active_date_diff,
    temp_active_retain_30activedays.active_days,
    temp_active_retain_30activedays.amount,
    temp_active_retain_30activedays.country,
