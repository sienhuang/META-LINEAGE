    FROM mt_dm.dm_active_pay_role_zone_di AS dm_active_pay_role_zone_di
    WHERE active_date = '2026-05-30' AND logymd IN ('2026-05-30', '2026-05-29', '2026-05-28', '2026-05-24', '2026-05-17', '2026-05-01', '2026-03-02') AND active_date_diff IN (0, 1, 2, 6, 13, 29, 89)
),
b AS (
    SELECT
        MAX(LEVEL) AS day_max_level,
        logymd,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE zoneid < 57000 AND is_ai = 0 AND logymd IN ('2026-05-30', '2026-05-29', '2026-05-28', '2026-05-24', '2026-05-17', '2026-05-01', '2026-03-02') AND appid = 'mlbb'
    GROUP BY roleid, zoneid, logymd
),
c AS (
    SELECT
        create_os,
        LOWER(first_mt_country) AS first_mt_country,
        first_network_name,
        CASE WHEN new_type = 1 THEN '小号回流新增' WHEN new_type = 2 THEN '模拟器新增' WHEN new_type = 3 THEN '纯净新增' WHEN new_type = 4 THEN '切换设备换绑' WHEN new_type = 5 THEN '小号新增' ELSE '无信息' END AS new_type,
        roleid,
        zoneid
    FROM mt_dim.dim_basic_role_zone_df AS dim_basic_role_zone_df
    WHERE logymd = IF('2026-05-30' < '2023-01-01', '2023-01-01', '2026-05-30') AND appid = 'mlbb' AND zoneid < 57000 AND is_ai = 0
    GROUP BY roleid, zoneid, LOWER(first_mt_country), create_os, first_network_name, CASE WHEN new_type = 1 THEN '小号回流新增' WHEN new_type = 2 THEN '模拟器新增' WHEN new_type = 3 THEN '纯净新增' WHEN new_type = 4 THEN '切换设备换绑' WHEN new_type = 5 THEN '小号新增' ELSE '无信息' END
),
d AS (
    SELECT
        country,
        lower
    FROM mt_dim.dim_national_geographic_atlas_config AS dim_national_geographic_atlas_config
),
e AS (
    SELECT
        his_activedays AS his_activedays_before_1,
        logymd,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_df AS dwm_active_role_zone_df
    WHERE logymd IN ('2026-05-29', '2026-05-28', '2026-05-27', '2026-05-23', '2026-05-16', '2026-04-30', '2026-03-01') AND appid = 'mlbb' AND zoneid < 57000
    GROUP BY logymd, roleid, zoneid, his_activedays
),
f AS (
    SELECT
        his_activedays AS his_activedays_before_31,
        logymd,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_df AS dwm_active_role_zone_df
    WHERE logymd IN ('2026-04-29', '2026-04-28', '2026-04-27', '2026-04-23', '2026-04-16', '2026-03-31', '2026-01-30') AND appid = 'mlbb' AND zoneid < 57000
    GROUP BY logymd, roleid, zoneid, his_activedays
),
a AS (
    SELECT
        a.active_date_diff,
        (COALESCE(e.his_activedays_before_1, 0) - COALESCE(f.his_activedays_before_31, 0)) AS active_days,
        a.charge_amt_total,
        d.country,
        c.create_os,
        b.day_max_level,
        c.first_network_name,
        a.is_active,
        a.logymd,
        c.new_type,
        a.roleid,
        a.user_period,
        a.zoneid
    FROM a
    LEFT JOIN b
        ON a.roleid = b.roleid AND a.zoneid = b.zoneid AND a.logymd = b.logymd
    LEFT JOIN c
        ON a.roleid = c.roleid AND a.zoneid = c.zoneid
    LEFT JOIN d
        ON c.first_mt_country = d.lower
    LEFT JOIN e
        ON a.roleid = e.roleid AND a.zoneid = e.zoneid AND a.logymd = DATE_ADD(e.logymd, 1) /* -------------匹配业务日期前1天历史累计活跃天数 */
