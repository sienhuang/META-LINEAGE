WITH
t1 AS (
    SELECT
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE logymd = '2026-03-30' AND zoneid < 57000 AND is_ai = 0
    GROUP BY roleid, zoneid
),
t3 AS (
    SELECT
        COUNT(DISTINCT logymd) AS active_days_7,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE logymd >= DATE_ADD('2026-03-30', 1) AND logymd <= DATE_ADD('2026-03-30', 7) AND zoneid < 57000
    GROUP BY roleid, zoneid
),
t4 AS (
    SELECT
        COUNT(DISTINCT logymd) AS active_days_14,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE logymd >= DATE_ADD('2026-03-30', 1) AND logymd <= DATE_ADD('2026-03-30', 14) AND zoneid < 57000
    GROUP BY roleid, zoneid
),
t5 AS (
    SELECT
        COUNT(DISTINCT logymd) AS active_days_21,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE logymd >= DATE_ADD('2026-03-30', 1) AND logymd <= DATE_ADD('2026-03-30', 21) AND zoneid < 57000
    GROUP BY roleid, zoneid
),
t6 AS (
    SELECT
        COUNT(DISTINCT logymd) AS active_days_30,
        roleid,
        zoneid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE logymd >= DATE_ADD('2026-03-30', 1) AND logymd <= DATE_ADD('2026-03-30', 30) AND zoneid < 57000
    GROUP BY roleid, zoneid
),
zqm_20240725_future_loss_login_feature AS (
    SELECT
        active_days_14 /* 未来14日（不含当日）活跃天数（不含当日） */,
        active_days_21 /* 未来21日（不含当日）活跃天数（不含当日） */,
        active_days_30 /* 未来30日（不含当日）活跃天数（不含当日） */,
        active_days_7 /* 未来7日（不含当日）活跃天数（不含当日） */,
        CASE WHEN active_days_14 IS NULL THEN 1 ELSE 0 END AS if_loss_14 /* 是否14日流失用户 */,
        CASE WHEN active_days_21 IS NULL THEN 1 ELSE 0 END AS if_loss_21 /* 是否21日流失用户 */,
        CASE WHEN active_days_30 IS NULL THEN 1 ELSE 0 END AS if_loss_30 /* 是否30日流失用户 */,
        CASE WHEN active_days_7 IS NULL THEN 1 ELSE 0 END AS if_loss_7 /* 是否7日流失用户（未来连续1-7天未活跃） */,
        t1.roleid,
        t1.zoneid
    FROM t1
    LEFT JOIN t3
        ON t1.roleid = t3.roleid AND t1.zoneid = t3.zoneid
    LEFT JOIN t4
        ON t1.roleid = t4.roleid AND t1.zoneid = t4.zoneid
    LEFT JOIN t5
        ON t1.roleid = t5.roleid AND t1.zoneid = t5.zoneid
    LEFT JOIN t6
        ON t1.roleid = t6.roleid AND t1.zoneid = t6.zoneid
    GROUP BY t1.roleid, t1.zoneid, active_days_7 /* 未来7日（不含当日）活跃天数（不含当日） */, active_days_14 /* 未来14日（不含当日）活跃天数（不含当日） */, active_days_21 /* 未来21日（不含当日）活跃天数（不含当日） */, active_days_30 /* 未来30日（不含当日）活跃天数（不含当日） */, CASE WHEN register_date = '2026-03-30' THEN 1 ELSE 0 END /* 是否当日新增 */, CASE WHEN active_days_7 IS NULL THEN 1 ELSE 0 END /* 是否7日流失用户（未来连续1-7天未活跃） */, CASE WHEN active_days_14 IS NULL THEN 1 ELSE 0 END /* 是否14日流失用户 */, CASE WHEN active_days_21 IS NULL THEN 1 ELSE 0 END /* 是否21日流失用户 */, CASE WHEN active_days_30 IS NULL THEN 1 ELSE 0 END /* 是否30日流失用户 */, CASE WHEN active_days_31 IS NULL THEN 1 ELSE 0 END /* 是否31日流失用户 */
)
SELECT
    zqm_20240725_future_loss_login_feature.active_days_14,
    zqm_20240725_future_loss_login_feature.active_days_21,
    zqm_20240725_future_loss_login_feature.active_days_30,
    zqm_20240725_future_loss_login_feature.active_days_7,
    zqm_20240725_future_loss_login_feature.if_loss_14,
    zqm_20240725_future_loss_login_feature.if_loss_21,
    zqm_20240725_future_loss_login_feature.if_loss_30,
    zqm_20240725_future_loss_login_feature.if_loss_7,
    zqm_20240725_future_loss_login_feature.roleid,
    zqm_20240725_future_loss_login_feature.zoneid
FROM zqm_20240725_future_loss_login_feature;
