2026-07-03 13:51:31,680 metawiki.parse_etl.lineage INFO 整条链路 SQL:
-- 可分析维度: active_label, network_group, country, age_group
WITH
basic AS (
    SELECT
        first_mt_country AS country,
        first_network_name AS network,
        IF(LOWER(first_network_name) = 'organic', 1, 2) AS network_group,
        roleid
    FROM mt_dim.dim_basic_role_zone_df AS dim_basic_role_zone_df
    WHERE logymd = IF('2026-05-31' <= '2024-01-01', '2024-01-01', '2026-05-31') AND register_date <= '2026-05-31' AND appid = 'mlbb' AND is_ai = 0 AND is_first_create = 1
),
active_di AS (
    SELECT
        roleid
    FROM mt_dwm.dwm_active_role_zone_di AS dwm_active_role_zone_di
    WHERE logymd = '2026-05-31' AND appid = 'mlbb' AND /* AND     is_ai = 0 */ IF('2026-05-31' <= '2025-01-03', zoneid < 57000, zoneid > 0)
    GROUP BY roleid
),
lose_active_di AS (
    SELECT
        active_label,
        roleid
    FROM mt_dim.dim_gamebi_active_pay_di AS dim_gamebi_active_pay_di
    WHERE logymd = '2026-05-31' AND granularity_type = 'account57'
),
attribute_account_df AS (
    SELECT
        accountid,
        age,
        CASE WHEN age BETWEEN 7 AND 9 THEN '1' WHEN age BETWEEN 10 AND 14 THEN '2' WHEN age BETWEEN 15 AND 19 THEN '3' WHEN age BETWEEN 20 AND 24 THEN '4' WHEN age BETWEEN 25 AND 29 THEN '5' WHEN age BETWEEN 30 AND 34 THEN '6' WHEN age >= 35 THEN '7' END AS age_group /* 年龄段 */
    FROM mt_dim.dim_basic_attribute_account_df AS dim_basic_attribute_account_df
    WHERE logymd = '2026-05-31' AND appid = 'mlbb' AND gt2 = 1
),
ads_decismart_active_di AS (
    SELECT
        COUNT(*) AS active_cnt,
        COALESCE(los.active_label, -99999) AS active_label,
        COALESCE(attr.age_group, -99999) AS age_group,
        COALESCE(bas.country, 'unknown') AS country,
        COALESCE(bas.network_group, -99999) AS network_group
    FROM active_di AS act
    JOIN basic AS bas
        ON act.roleid = bas.roleid
    LEFT JOIN lose_active_di AS los
        ON act.roleid = los.roleid
    LEFT JOIN attribute_account_df AS attr
        ON act.roleid = attr.accountid
    GROUP BY COALESCE(bas.country, 'unknown'), COALESCE(los.active_label, -99999) /* NVL(bas.os, 'unknown'), */ /* NVL(bas.network, 'unknown'), */, COALESCE(attr.age_group, -99999), COALESCE(bas.network_group, -99999)
)
SELECT
    ads_decismart_active_di.active_label,
    ads_decismart_active_di.network_group,
    ads_decismart_active_di.country,
    ads_decismart_active_di.age_group,
    ads_decismart_active_di.active_cnt
FROM ads_decismart_active_di;
